{
  "name": "@openfoundry/observability",
  "version": "0.0.1",
  "private": true,
  "description": "Shared OpenTelemetry instrumentation utilities for Open Foundry",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@opentelemetry/api": "~1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/sdk-node": "^0.301.2",
    "pino": "^10.4.0"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
