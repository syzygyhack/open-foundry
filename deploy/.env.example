# ─── PostgreSQL ──────────────────────────────────────────────────
POSTGRES_DB=openfoundry
POSTGRES_USER=openfoundry
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# ─── Redpanda (Kafka-compatible) ────────────────────────────────
REDPANDA_PORT=19092

# ─── Redis (distributed rate limiting) ─────────────────────────
REDIS_PORT=6379

# ─── OpenFGA ─────────────────────────────────────────────────────
OPENFGA_PORT=8280
OPENFGA_STORE_ID=

# ─── Keycloak ────────────────────────────────────────────────────
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme
KEYCLOAK_REALM=openfoundry

# ─── Debezium ────────────────────────────────────────────────────
DEBEZIUM_PORT=8083

# ─── OpenTelemetry Collector ─────────────────────────────────────
OTEL_PORT=4317

# ─── CEL Evaluator (gRPC) ───────────────────────────────────────
CEL_PORT=50051

# ─── API Gateway ─────────────────────────────────────────────────
API_PORT=4000

# ─── OIDC (production auth; NODE_ENV=production) ─────────────────
# Opt-in fallback tenant for IdP tokens WITHOUT a `tenant_id` claim. Unset by
# default → fail-closed (claimless tokens are rejected); a real `tenant_id` claim
# always takes precedence. Single-tenant deployments can opt in:
# OIDC_DEFAULT_TENANT=default

# ─── Build ──────────────────────────────────────────────────────
# Git revision stamped into Docker image labels.
# Set automatically by: GIT_REVISION=$(git rev-parse HEAD) docker compose up --build
# GIT_REVISION=

# ─── Domain Packs ────────────────────────────────────────────────
# Comma-separated list of pack names to activate (omit for all discovered packs).
# DOMAIN_PACKS=core,nhs-acute

# External pack directories (colon-separated on POSIX, semicolon on Windows).
# Each entry may be a parent directory containing pack subdirectories, or a
# direct path to a single pack directory (one that contains pack.yaml).
# Inside the container these resolve to the mount point below.
# DOMAIN_PACKS_EXTRA_DIRS=/external-packs

# Host path mounted into the api-gateway container at /external-packs.
# May be a parent dir (subdirs scanned) or a direct pack dir.
# DOMAIN_PACKS_HOST_DIR=../../silmaril-dp-rce

# ─── Governance policy (deployment-specific) ─────────────────────
# Platform roles allowed to grant relationships / record consent. The platform
# default is `admin` only — no domain-specific roles are forced. NHS deployments
# add the clinical roles by uncommenting these:
# RELATIONSHIP_GRANTER_ROLES=admin,nurse_in_charge
# CONSENT_RECORDER_ROLES=admin,nurse_in_charge,clinician
#
# Consent-purpose vocabulary. `DataPurpose` is an OPEN string type — a deployment
# defines its own purposes. Unset → the standard NHS/UK-IG preset (DIRECT_CARE,
# CARE_PLANNING, SERVICE_MANAGEMENT, RESEARCH, NATIONAL_REPORTING). A non-NHS
# deployment lists its own (the default purpose must be one of them):
# CONSENT_PURPOSES=KYC,AML_MONITORING
# DEFAULT_CONSENT_PURPOSE=KYC
#
# Object types whose @param marks an action's consent subject (consent is checked
# for that object before the action runs). Unset → Patient (NHS). A non-NHS
# deployment sets its own subject type(s); comma-separated. NOTE: when the
# relationship exemption below is enabled, exactly ONE subject type is supported
# (the exemption resolves a single FGA prefix) — the gateway fails fast otherwise.
# CONSENT_SUBJECT_TYPES=Customer
#
# Legitimate-relationship consent exemption (NHS Act 2006 s251 direct-care is the
# reference case). Platform default OFF. NHS deployments enable it; the docker
# compose NHS reference stack already sets it true.
# CONSENT_DIRECT_CARE_EXEMPTION=true
# CONSENT_EXEMPTION_PURPOSE=DIRECT_CARE
